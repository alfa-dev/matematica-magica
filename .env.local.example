# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase
# Dashboard Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Necessária para o painel /admin (só rafael.mediario@gmail.com consegue entrar).
# Fica só no servidor (Vercel > Environment Variables) — NUNCA prefixar com NEXT_PUBLIC_
# nem expor no client. Pegue em Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui
